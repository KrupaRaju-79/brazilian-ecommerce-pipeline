# =============================================================
# .gitignore — Brazilian E-Commerce GCP Pipeline
# Updated through: Day 3 (Apache Beam + Dataflow)
# =============================================================


# =============================================================
# SECURITY — NEVER commit these under any circumstances
# =============================================================

# GCP service account keys (JSON key downloaded on Day 1)
credentials/
*.json
!infrastructure/gcs_lifecycle.json
!ingestion/bq_schemas/*.json
*.key
*.pem
*.p12

# Environment variable files
.env
.env.*
.env.local

# Terraform state and variable files (contain project IDs, secrets)
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
terraform.tfvars
terraform.tfvars.json
.terraform/
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# =============================================================
# DAY 1 — GCP setup
# =============================================================

# gcloud CLI auth files
application_default_credentials.json
gcloud/


# =============================================================
# DAY 2 — BigQuery
# =============================================================

# BigQuery export files downloaded locally
*.bq
bq_export/

# Validation report (generated file — recreate by running the script)
docs/validation_report_day2.md


# =============================================================
# DAY 3 — Apache Beam + Python environment
# =============================================================

# Virtual environment — NEVER commit this (500MB+)
venv/
.venv/
env/
ENV/
venv.bak/

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Python egg / build artifacts
*.egg-info/
*.egg
dist/
build/
.eggs/
wheels/

# pytest cache
.pytest_cache/
.coverage
htmlcov/
.tox/

# Beam pipeline temporary files
# (Dataflow runner creates these in your temp bucket, but if
#  DirectRunner creates local temp files, ignore them)
beam-temp*/
/tmp/beam*/
dataflow_temp/

# Beam pickled pipeline artifacts (created during DirectRunner runs)
*.pickle
pickled_beam_*


# =============================================================
# DATA FILES — Too large for git, stored in GCS instead
# =============================================================

# Source CSV files (stored in gs://BUCKET/raw/)
data/
*.csv
*.parquet
*.avro
*.orc

# Cleaned intermediate files (e.g. fix_reviews_csv.py output)
*_clean.csv
*_fixed.csv


# =============================================================
# IDE and OS files
# =============================================================

# VS Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# =============================================================
# JUPYTER NOTEBOOKS
# =============================================================

.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints


# =============================================================
# DBT — Day 4 (added now so repo is ready)
# =============================================================

# dbt compiled SQL and run artifacts (regenerated by dbt build)
dbt_project/target/
dbt_project/logs/

# dbt installed packages (like pip's venv — install from packages.yml)
dbt_project/dbt_packages/

# dbt credentials profile (contains your BQ project + keyfile path)
dbt_project/profiles.yml


# =============================================================
# CLOUD COMPOSER / AIRFLOW — Day 6
# =============================================================

# Airflow local DB and logs (only relevant if running Airflow locally)
airflow.db
airflow/logs/
airflow/plugins/
logs/


# =============================================================
# WHAT IS NOT IGNORED (intentionally tracked in git)
# =============================================================
# infrastructure/gcs_lifecycle.json   — safe, no secrets
# ingestion/bq_schemas/*.json         — safe, just table schemas
# .github/workflows/*.yml             — CI/CD definitions
# requirements.txt                    — dependency versions
# scripts/*.sh                        — shell scripts
# docs/*.md                           — all documentation